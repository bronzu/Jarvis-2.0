    {
      "label": "Fase A protocollo (prescribed)",
      "n_components": 1536,
      "criteria": {
        "forget_nll_per_token": 4.85759171593573,
        "forget_loglik_per_token": -4.85759171593573,
        "z_one_sided": 7.702372897906259,
