# Artefatto generato dai test: TESTS/test_e2e_jarvis.py crea questa directory e
# vi scrive jarvis_test.txt a ogni esecuzione della suite.
jarvis_e2e_fs_test/
experiments/*
# La validazione del Continual Learning e' citata come sorgente dei numeri
# in 17_MODEL_TRAINING_PROVENANCE.md sezione 13.7.4: senza questi file il
# comando di riproduzione citato non funziona per nessun altro. Si esclude
# `experiments/*` e non `experiments/` perche' git non puo' re-includere un
# file se una directory padre e' esclusa.
!experiments/phase4_continual_learning/
!experiments/phase4_continual_learning/**
experiments/phase4_continual_learning/__pycache__/
# Stessa eccezione per la Missione 1 (machine unlearning): i numeri del
# report di competenza sono citati come sorgente e TESTS/test_unlearning.py
# importa questi moduli, quindi senza i file il comando di riproduzione non
# funziona per nessun altro.
!experiments/mission1_unlearning/
!experiments/mission1_unlearning/**
experiments/mission1_unlearning/__pycache__/
neural_core/data/*.pkl
neural_core/data/*.json
neural_core/data/*.txt
!neural_core/data/tokenizer.json
!neural_core/data/provenance_manifest.json
!neural_core/data/baseline_manifest.json
!neural_core/data/baseline_benchmark.json
!neural_core/data/jarvis_dialogue.txt
!neural_core/data/corpus_addestramento.txt

